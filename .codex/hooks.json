{
  "description": "Require an exact staged-diff ADR review before Codex commits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/adr-gate.mjs\" codex-pre-tool",
            "timeout": 30,
            "statusMessage": "Checking ADR commit review"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/adr-gate.mjs\" codex-stop",
            "timeout": 30,
            "statusMessage": "Checking ADR review state"
          }
        ]
      }
    ]
  }
}
