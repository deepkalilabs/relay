# Persistence API
# Required by the FastAPI persistence service.
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
BASIC_AUTH_USERNAME=relay
BASIC_AUTH_PASSWORD=change-me
BUCKET=
ENDPOINT=https://storage.railway.app
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto

# Authenticated FastAPI gateway target. Override with the private service URL in Railway.
AUTOMATION_SERVICE_URL=http://127.0.0.1:8080

# Browserbase execution
# Required only for real Browserbase runs.
BROWSERBASE_API_KEY=

# Automation run service defaults to 127.0.0.1:8080 and requires no service token.
# These production values permit screenshots only when the listener is protected by
# Railway private networking. Deploy the supporting build with screenshots disabled
# before enabling both values; never add a public domain to relay-automation.
AUTOMATION_TRUST_PRIVATE_NETWORK=1
AUTOMATION_SCREENSHOTS=true
