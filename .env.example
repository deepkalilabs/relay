# Required. Keep this value server-side; never prefix it with NEXT_PUBLIC_.
BROWSERBASE_API_KEY=

# Optional. Browserbase infers the project from the API key when omitted.
BROWSERBASE_PROJECT_ID=

# Optional defaults.
BROWSERBASE_REGION=us-west-2
BROWSERBASE_SESSION_TIMEOUT_SECONDS=1800

# Optional. Defaults to .data/workflows relative to the project.
WORKFLOW_DATA_DIR=

# Optional. Defaults to .data/profiles relative to the project.
PROFILE_DATA_DIR=

PORT=3000
